# ================================================================
# 环境变量模板 —— 复制本文件为 .env 后填入真实值
#   copy .env.example .env
# .env 已被 .gitignore 排除，不会进入版本库。
# ================================================================

# ---- 大模型：DeepSeek（走 OpenAI 兼容接口）----
# 申请地址：https://platform.deepseek.com/
# 未配置时：需要 AI 的页面会给出「未检测到环境变量 DEEPSEEK_API_KEY」提示，
#          其余规则类功能不受影响。
DEEPSEEK_API_KEY=

# ---- 高德地图：地址核查模块的地理编码 ----
# 申请地址：https://lbs.amap.com/ （需开通「Web服务」类型 Key）
# 未配置时：地址核查模块只能做规则比对，无法做坐标距离核实。
AMAP_API_KEY=

# ---- 服务启动参数（可选，一般不用改）----
# DWC_HOST=127.0.0.1     # 默认只监听本机；部署到云服务器时改为 0.0.0.0
# DWC_PORT=8080
# DWC_DEBUG=1            # 本地调试时打开（含热重载）；对外演示/部署时务必关闭
